diff --git a/lib/Basic/UUID.cpp b/lib/Basic/UUID.cpp
index 7aa78e83..f551363c 100644
--- a/lib/Basic/UUID.cpp
+++ b/lib/Basic/UUID.cpp
@@ -27,6 +27,30 @@
 #include <objbase.h>
 #include <string>
 #include <algorithm>
+#elif defined(__wasi__)
+// WASI has no libuuid. The operations are small enough to implement directly: 16
+// random bytes from getentropy(), the RFC 4122 version and variant bits, and hex
+// formatting. wasm has no MAC address and no stable clock sequence, so time-based
+// UUIDs are generated randomly here too — they remain unique, just not sortable.
+#include <cstdio>
+#include <cstring>
+#include <unistd.h>
+
+namespace {
+void wasiRandomUUID(unsigned char (&value)[swift::UUID::Size]) {
+  if (getentropy(value, swift::UUID::Size) != 0)
+    memset(value, 0, swift::UUID::Size);
+  value[6] = (value[6] & 0x0F) | 0x40; // version 4
+  value[8] = (value[8] & 0x3F) | 0x80; // RFC 4122 variant
+}
+
+int wasiHexDigit(char c) {
+  if (c >= '0' && c <= '9') return c - '0';
+  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+  return -1;
+}
+} // end anonymous namespace
 #else
 #include <uuid/uuid.h>
 #endif
