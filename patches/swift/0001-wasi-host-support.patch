diff --git a/tools/SourceKit/lib/Support/Concurrency-cooperative.cpp b/tools/SourceKit/lib/Support/Concurrency-cooperative.cpp
new file mode 100644
index 00000000..9180f1fe
--- /dev/null
+++ b/tools/SourceKit/lib/Support/Concurrency-cooperative.cpp
@@ -0,0 +1,303 @@
+//===--- Concurrency-cooperative.cpp --------------------------------------===//
+//
+// This source file is part of the Swift.org open source project
+//
+// Copyright (c) 2014 - 2026 Apple Inc. and the Swift project authors
+// Licensed under Apache License v2.0 with Runtime Library Exception
+//
+// See https://swift.org/LICENSE.txt for license information
+// See https://swift.org/CONTRIBUTORS.txt for the list of Swift project authors
+//
+//===----------------------------------------------------------------------===//
+//
+// SourceKit's work queues and semaphores for a host with one thread and no
+// libdispatch (WASI). Concurrency-libdispatch.cpp is the implementation
+// everywhere else; this one keeps the same contract with nothing to run on but
+// the caller's own thread:
+//
+//  * dispatch, dispatchBarrier, dispatchConcurrent and dispatchOnMain only
+//    enqueue. Nothing runs at the point of submission, so a caller that holds
+//    a lock while it dispatches never has the work run underneath it.
+//  * Queued work runs when somebody waits for it: Semaphore::wait,
+//    dispatchSync, dispatchBarrierSync, or WorkQueue::runPendingWork.
+//  * Serial queues and barriers keep their meaning. An item does not start
+//    while an item of the same serial queue, or a barrier of the same
+//    concurrent queue, is still on the stack, and items submitted after a
+//    barrier wait for it. Suspended queues run nothing until resumed.
+//  * A wait that nothing can satisfy is a deadlock that libdispatch would hit
+//    as well; here it is reported, instead of hanging a single-threaded host
+//    forever. A timed wait that nothing can satisfy times out at once, since
+//    no other thread exists to signal it later.
+//  * isStackDeep has no larger thread to move to. The work runs on the
+//    caller's stack, so the module must be linked with a large stack
+//    (-z stack-size); libdispatch's path uses 8 MiB.
+//
+// Priorities are accepted and ignored: everything runs in submission order.
+//
+//===----------------------------------------------------------------------===//
+
+#include "SourceKit/Support/Concurrency.h"
+#include "llvm/ADT/Twine.h"
+#include "llvm/Support/ErrorHandling.h"
+#include <algorithm>
+#include <deque>
+#include <string>
+#include <vector>
+
+using namespace SourceKit;
+
+namespace {
+
+struct QueueState {
+  std::string Label;
+  bool IsSerial;
+  unsigned RefCount = 1;
+  unsigned SuspendCount = 0;
+  /// Items of this queue currently executing, i.e. somewhere on the stack.
+  unsigned Running = 0;
+  /// Of those, how many are barriers.
+  unsigned RunningBarriers = 0;
+
+  QueueState(llvm::StringRef Label, bool IsSerial)
+      : Label(Label.str()), IsSerial(IsSerial) {}
+};
+
+struct WorkItem {
+  QueueState *Queue;
+  void *Context;
+  WorkQueue::DispatchFn Fn;
+  bool IsBarrier;
+};
+
+struct SemaphoreState {
+  long Count;
+  unsigned RefCount = 1;
+
+  explicit SemaphoreState(long Count) : Count(Count) {}
+};
+
+// Both are created on first use, never at static initialization: other
+// translation units dispatch from their own static initializers.
+
+/// The main queue, which libdispatch drains on the main thread. Here it is a
+/// serial queue like any other, and never released.
+QueueState *mainQueue() {
+  static QueueState *Q = new QueueState("main", /*IsSerial=*/true);
+  return Q;
+}
+
+/// The global concurrent queues, one for every priority, merged into one.
+QueueState *globalQueue() {
+  static QueueState *Q = new QueueState("global", /*IsSerial=*/false);
+  return Q;
+}
+
+std::deque<WorkItem> &pending() {
+  static std::deque<WorkItem> *Pending = new std::deque<WorkItem>();
+  return *Pending;
+}
+
+bool isImmortal(const QueueState *Q) {
+  return Q == mainQueue() || Q == globalQueue();
+}
+
+void retainQueue(QueueState *Q) {
+  if (!isImmortal(Q))
+    ++Q->RefCount;
+}
+
+void releaseQueue(QueueState *Q) {
+  if (isImmortal(Q))
+    return;
+  if (--Q->RefCount == 0)
+    delete Q;
+}
+
+/// Whether an item may start now, given what is already on the stack.
+bool mayStart(const QueueState &Q, bool IsBarrier) {
+  if (Q.SuspendCount > 0)
+    return false;
+  if (Q.IsSerial || IsBarrier)
+    return Q.Running == 0;
+  return Q.RunningBarriers == 0;
+}
+
+void execute(QueueState *Q, bool IsBarrier, void *Context,
+             WorkQueue::DispatchFn Fn) {
+  ++Q->Running;
+  if (IsBarrier)
+    ++Q->RunningBarriers;
+  Fn(Context);
+  if (IsBarrier)
+    --Q->RunningBarriers;
+  --Q->Running;
+}
+
+/// Runs the oldest item that may start, if there is one.
+bool runOne() {
+  auto &Pending = pending();
+  // A queue whose oldest pending item cannot start yet holds back everything
+  // queued after it, which is what keeps serial queues in order and makes
+  // later items wait for a barrier.
+  std::vector<const QueueState *> HeldBack;
+  for (auto It = Pending.begin(); It != Pending.end(); ++It) {
+    QueueState *Q = It->Queue;
+    if (std::find(HeldBack.begin(), HeldBack.end(), Q) != HeldBack.end())
+      continue;
+    bool StartsSerially = Q->IsSerial || It->IsBarrier;
+    if (!mayStart(*Q, It->IsBarrier)) {
+      if (StartsSerially || Q->SuspendCount > 0)
+        HeldBack.push_back(Q);
+      continue;
+    }
+    WorkItem Item = *It;
+    Pending.erase(It);
+    execute(Item.Queue, Item.IsBarrier, Item.Context, Item.Fn);
+    releaseQueue(Item.Queue);
+    return true;
+  }
+  return false;
+}
+
+/// Whether anything queued on \p Q must finish before a synchronous item of
+/// that queue may run.
+bool hasPendingPredecessor(const QueueState *Q, bool IsBarrier) {
+  bool WaitsForAll = Q->IsSerial || IsBarrier;
+  for (const WorkItem &Item : pending())
+    if (Item.Queue == Q && (WaitsForAll || Item.IsBarrier))
+      return true;
+  return false;
+}
+
+void enqueue(QueueState *Q, void *Context, WorkQueue::DispatchFn Fn,
+             bool IsBarrier) {
+  retainQueue(Q);
+  pending().push_back(WorkItem{Q, Context, Fn, IsBarrier});
+}
+
+void runSync(QueueState *Q, void *Context, WorkQueue::DispatchFn Fn,
+             bool IsBarrier) {
+  while (hasPendingPredecessor(Q, IsBarrier) || !mayStart(*Q, IsBarrier)) {
+    if (!runOne())
+      llvm::report_fatal_error(
+          "SourceKit: synchronous dispatch onto '" + llvm::Twine(Q->Label) +
+          "' would wait forever: its queue is suspended or already running "
+          "on this, the only, thread");
+  }
+  execute(Q, IsBarrier, Context, Fn);
+}
+
+QueueState *toQueue(void *Obj) { return static_cast<QueueState *>(Obj); }
+SemaphoreState *toSemaphore(void *Obj) {
+  return static_cast<SemaphoreState *>(Obj);
+}
+
+} // end anonymous namespace
+
+//===----------------------------------------------------------------------===//
+// Semaphore
+//===----------------------------------------------------------------------===//
+
+void *Semaphore::Impl::create(long count) { return new SemaphoreState(count); }
+
+void Semaphore::Impl::signal(Ty Obj) { ++toSemaphore(Obj)->Count; }
+
+bool Semaphore::Impl::wait(Ty Obj) {
+  SemaphoreState *S = toSemaphore(Obj);
+  while (S->Count <= 0) {
+    if (!runOne())
+      llvm::report_fatal_error(
+          "SourceKit: Semaphore::wait would block forever: no queued work "
+          "can run, and there is no other thread to signal it");
+  }
+  --S->Count;
+  return false;
+}
+
+bool Semaphore::Impl::wait(Ty Obj, long milliseconds) {
+  (void)milliseconds;
+  SemaphoreState *S = toSemaphore(Obj);
+  while (S->Count <= 0) {
+    if (!runOne())
+      return true; // Nothing left that could signal it: timed out.
+  }
+  --S->Count;
+  return false;
+}
+
+void Semaphore::Impl::retain(Ty Obj) { ++toSemaphore(Obj)->RefCount; }
+
+void Semaphore::Impl::release(Ty Obj) {
+  SemaphoreState *S = toSemaphore(Obj);
+  if (--S->RefCount == 0)
+    delete S;
+}
+
+//===----------------------------------------------------------------------===//
+// WorkQueue
+//===----------------------------------------------------------------------===//
+
+void *WorkQueue::Impl::create(Dequeuing DeqKind, Priority Prio,
+                              llvm::StringRef Label) {
+  (void)Prio;
+  return new QueueState(Label, DeqKind == Dequeuing::Serial);
+}
+
+void WorkQueue::Impl::dispatch(Ty Obj, const DispatchData &Fn) {
+  enqueue(toQueue(Obj), Fn.getContext(), Fn.getFunction(),
+          /*IsBarrier=*/false);
+}
+
+void WorkQueue::Impl::dispatchSync(Ty Obj, const DispatchData &Fn) {
+  runSync(toQueue(Obj), Fn.getContext(), Fn.getFunction(),
+          /*IsBarrier=*/false);
+}
+
+void WorkQueue::Impl::dispatchBarrier(Ty Obj, const DispatchData &Fn) {
+  enqueue(toQueue(Obj), Fn.getContext(), Fn.getFunction(), /*IsBarrier=*/true);
+}
+
+void WorkQueue::Impl::dispatchBarrierSync(Ty Obj, const DispatchData &Fn) {
+  runSync(toQueue(Obj), Fn.getContext(), Fn.getFunction(), /*IsBarrier=*/true);
+}
+
+void WorkQueue::Impl::dispatchOnMain(const DispatchData &Fn) {
+  enqueue(mainQueue(), Fn.getContext(), Fn.getFunction(), /*IsBarrier=*/false);
+}
+
+void WorkQueue::Impl::dispatchConcurrent(Priority Prio,
+                                         const DispatchData &Fn) {
+  (void)Prio;
+  enqueue(globalQueue(), Fn.getContext(), Fn.getFunction(),
+          /*IsBarrier=*/false);
+}
+
+void WorkQueue::Impl::suspend(Ty Obj) { ++toQueue(Obj)->SuspendCount; }
+
+void WorkQueue::Impl::resume(Ty Obj) {
+  QueueState *Q = toQueue(Obj);
+  if (Q->SuspendCount == 0)
+    llvm::report_fatal_error("SourceKit: WorkQueue resumed more often than "
+                             "it was suspended");
+  --Q->SuspendCount;
+}
+
+void WorkQueue::Impl::setPriority(Ty Obj, Priority Prio) {
+  (void)Obj;
+  (void)Prio;
+}
+
+llvm::StringRef WorkQueue::Impl::getLabel(const Ty Obj) {
+  return toQueue(Obj)->Label;
+}
+
+void WorkQueue::Impl::retain(Ty Obj) { retainQueue(toQueue(Obj)); }
+
+void WorkQueue::Impl::release(Ty Obj) { releaseQueue(toQueue(Obj)); }
+
+unsigned WorkQueue::runPendingWork() {
+  unsigned Ran = 0;
+  while (runOne())
+    ++Ran;
+  return Ran;
+}
