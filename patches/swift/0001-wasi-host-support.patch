diff --git a/tools/SourceKit/tools/sourcekitd-request/sourcekitd-request.cpp b/tools/SourceKit/tools/sourcekitd-request/sourcekitd-request.cpp
new file mode 100644
index 00000000..46985a16
--- /dev/null
+++ b/tools/SourceKit/tools/sourcekitd-request/sourcekitd-request.cpp
@@ -0,0 +1,124 @@
+//===--- sourcekitd-request.cpp - Send requests to in-process sourcekitd --===//
+//
+// This source file is part of the Swift.org open source project
+//
+// Copyright (c) 2014 - 2026 Apple Inc. and the Swift project authors
+// Licensed under Apache License v2.0 with Runtime Library Exception
+//
+// See https://swift.org/LICENSE.txt for license information
+// See https://swift.org/CONTRIBUTORS.txt for the list of Swift project authors
+//
+//===----------------------------------------------------------------------===//
+//
+// Sends requests, written in sourcekitd's YAML form, to the in-process
+// sourcekitd, one at a time and synchronously, and prints each response.
+//
+//   sourcekitd-request [-json] <request.yaml | ->...
+//
+// It is the smallest client of the C API, and the one a host without processes
+// or threads can run: no XPC service, no spawned tools, no notification thread
+// and no dispatch_main, which is everything sourcekitd-test needs and a WASI
+// host lacks. A request names its source file and compiler arguments itself,
+// for example:
+//
+//   {
+//     key.request: source.request.codecomplete,
+//     key.sourcefile: "/work/main.swift",
+//     key.offset: 42,
+//     key.compilerargs: ["/work/main.swift", "-target",
+//                        "wasm32-unknown-wasip1", ...]
+//   }
+//
+// Exit status: 0 when every response succeeded, 1 when any response was an
+// error, 2 when a request could not be read or parsed.
+//
+//===----------------------------------------------------------------------===//
+
+#include "sourcekitd/sourcekitd.h"
+#include "SourceKit/Support/Concurrency.h"
+
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+static void runPendingWork() {
+#if defined(__wasi__)
+  // Without threads, work nobody waits for (notifications, releasing ASTs)
+  // runs only when asked to. Finish it before the next request, so a request
+  // never observes half of the previous one.
+  SourceKit::WorkQueue::runPendingWork();
+#endif
+}
+
+static void printResponse(sourcekitd_response_t Resp, bool AsJSON) {
+  if (!AsJSON) {
+    sourcekitd_response_description_dump_filedesc(Resp, STDOUT_FILENO);
+    return;
+  }
+  char *JSON =
+      sourcekitd_variant_json_description_copy(sourcekitd_response_get_value(Resp));
+  llvm::outs() << JSON << '\n';
+  llvm::outs().flush();
+  free(JSON);
+}
+
+int main(int argc, const char **argv) {
+  bool AsJSON = false;
+  std::vector<std::string> Inputs;
+  for (int I = 1; I < argc; ++I) {
+    if (std::strcmp(argv[I], "-json") == 0)
+      AsJSON = true;
+    else
+      Inputs.push_back(argv[I]);
+  }
+  if (Inputs.empty()) {
+    llvm::errs() << "usage: " << argv[0]
+                 << " [-json] <request.yaml | ->...\n"
+                    "Sends each request to the in-process sourcekitd and "
+                    "prints the response; - reads one request from stdin.\n";
+    return 2;
+  }
+
+  sourcekitd_initialize();
+  int Status = 0;
+  for (const std::string &Input : Inputs) {
+    auto Buffer = llvm::MemoryBuffer::getFileOrSTDIN(Input);
+    if (!Buffer) {
+      llvm::errs() << "error: cannot read " << Input << ": "
+                   << Buffer.getError().message() << '\n';
+      Status = 2;
+      break;
+    }
+
+    char *Error = nullptr;
+    sourcekitd_object_t Req = sourcekitd_request_create_from_yaml(
+        (*Buffer)->getBuffer().str().c_str(), &Error);
+    if (!Req) {
+      llvm::errs() << "error: cannot parse " << Input << ": "
+                   << (Error ? Error : "unknown error") << '\n';
+      free(Error);
+      Status = 2;
+      break;
+    }
+
+    sourcekitd_response_t Resp = sourcekitd_send_request_sync(Req);
+    sourcekitd_request_release(Req);
+    if (sourcekitd_response_is_error(Resp)) {
+      llvm::errs() << "error: " << Input << ": "
+                   << sourcekitd_response_error_get_description(Resp) << '\n';
+      Status = 1;
+    } else {
+      printResponse(Resp, AsJSON);
+    }
+    sourcekitd_response_dispose(Resp);
+    runPendingWork();
+  }
+  sourcekitd_shutdown();
+  runPendingWork();
+  return Status;
+}
