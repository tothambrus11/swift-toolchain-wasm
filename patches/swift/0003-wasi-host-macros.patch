diff --git a/lib/AST/PluginRegistry.cpp b/lib/AST/PluginRegistry.cpp
index d526957..3dd7c55 100644
--- a/lib/AST/PluginRegistry.cpp
+++ b/lib/AST/PluginRegistry.cpp
@@ -38,6 +38,49 @@ PluginRegistry::PluginRegistry() {
   dumpMessaging = ::getenv("SWIFT_DUMP_PLUGIN_MESSAGING") != nullptr;
 }
 
+#if defined(__wasi__) && defined(SWIFT_BUILD_SWIFT_SYNTAX)
+// A WASI host has no dlopen, so there is no plugin server library to load.
+// The embedder is the plugin server: it provides these two functions as wasm
+// imports from the module "swift_plugin_host", answers the server's messages
+// (getCapability, loadPluginLibrary) itself, and runs the macro plugins, which
+// are wasm modules of their own.
+//
+// The calls are synchronous. `handle_message` receives one JSON request,
+// handles it, keeps the response, stores its length in bytes at
+// `responseLength`, and returns 0, or nonzero if the response is an error
+// message rather than a reply. `take_response` then copies those bytes to
+// `buffer`, which the compiler has allocated with exactly that length, and
+// forgets them. A frontend built this way cannot be instantiated without the
+// imports, even for a file that uses no macros.
+extern "C" {
+__attribute__((import_module("swift_plugin_host"),
+               import_name("handle_message"))) int32_t
+swift_plugin_host_handle_message(const char *request, uint32_t requestLength,
+                                 uint32_t *responseLength);
+
+__attribute__((import_module("swift_plugin_host"),
+               import_name("take_response"))) void
+swift_plugin_host_take_response(char *buffer);
+}
+
+/// `InProcessPlugins::HandleMessageFunction` over the embedder's imports.
+static bool handleMessageWithEmbedder(const char *requestData,
+                                      size_t requestLength,
+                                      char **responseDataPtr,
+                                      size_t *responseDataLengthPtr) {
+  uint32_t responseLength = 0;
+  int32_t status = swift_plugin_host_handle_message(
+      requestData, static_cast<uint32_t>(requestLength), &responseLength);
+  // Always take the response, so the embedder never holds a stale one. The
+  // caller frees the buffer; malloc(0) may return null, so ask for a byte.
+  auto *buffer = static_cast<char *>(malloc(responseLength ? responseLength : 1));
+  swift_plugin_host_take_response(buffer);
+  *responseDataPtr = buffer;
+  *responseDataLengthPtr = responseLength;
+  return status != 0;
+}
+#endif
+
